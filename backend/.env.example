# Deriv
DERIV_APP_ID=your_deriv_app_id
DERIV_SYSTEM_TOKEN=your_system_token_for_market_data

# AWS
AWS_REGION=us-east-1
DYNAMODB_TABLE_USERS=syntra-users
DYNAMODB_TABLE_TRADES=syntra-trades
DYNAMODB_TABLE_SIGNALS=syntra-signals
S3_BUCKET_CHARTS=syntra-charts-123456789
CLOUDFRONT_URL=https://cdn.syntra.app

# Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_client_id

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@syntra.app

# Email
SES_FROM_EMAIL=noreply@syntra.app

# Payment
BANK_INFO_SINPE=+50612345678
BANK_INFO_CUENTA=CR12345678901234567890

# Pricing (change here, redeploy to update without code changes)
MONTHLY_PRICE_USD=3.99
TRIAL_DAYS=30

# Admin (comma-separated Cognito sub UUIDs)
ADMIN_USER_IDS=uuid1,uuid2

# Token encryption secret
TOKEN_SECRET=change-this-to-a-random-secret-string

# MetaApi (generate at https://app.metaapi.cloud/token)
METAAPI_TOKEN=your_metaapi_token_here

# Telegram Bot (create at https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=SyntraSignalsBot
# Random secret to verify Telegram webhook requests (any strong random string)
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-random-secret
